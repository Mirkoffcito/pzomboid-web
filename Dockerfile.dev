FROM elixir:1.19.3-alpine

# Match host IDs to avoid root-owned files on bind mounts
ARG UID=1000
ARG GID=1000
RUN addgroup -g $GID app && adduser -D -u $UID -G app app

# System deps (keep Node out; handled by node/watchers services)
RUN apk add --no-cache \
    build-base \
    git \
    bash \
    inotify-tools \
    openssl \
    postgresql-client

# Set HOME before switching user
ENV HOME=/app
ENV MIX_HOME=/app/.mix
ENV HEX_HOME=/app/.mix

USER app
WORKDIR /app

RUN mkdir -p deps _build .mix

# Install hex + rebar as the app user
RUN mix local.hex --force && mix local.rebar --force

# Phoenix dev port
EXPOSE 4000

# Compose will run this by default
CMD ["bash","-lc","mix phx.server"]