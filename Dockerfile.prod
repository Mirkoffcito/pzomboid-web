# ================================================
# 1) BUILD STAGE
# ================================================
FROM elixir:1.19.3-slim AS build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git bash inotify-tools openssl libssl-dev \
    postgresql-client curl nodejs npm \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG UID=1000
ARG GID=1000

# Create non-root user
RUN groupadd -g $GID app && useradd -m -u $UID -g app app

# Ensure directories exist with correct perms
RUN mkdir -p /app/deps /app/_build /app/.mix && chown -R app:app /app

USER app

ENV MIX_ENV=prod \
    HOME=/app \
    MIX_HOME=/app/.mix \
    HEX_HOME=/app/.mix

RUN mix local.hex --force && mix local.rebar --force

# 1. Copy only mix.exs + mix.lock first (cache)
COPY --chown=app:app mix.exs mix.lock ./

# 2. Install deps
RUN mix deps.get --only prod
RUN mix deps.compile

# 3. Copy the full source code
COPY --chown=app:app . .

# 4. Clean previous build artifacts
RUN rm -rf deps _build

# 5. Reinstall deps in a clean state
RUN mix deps.get --only prod
RUN mix deps.compile

# 6. Build assets + release
RUN mix assets.deploy
RUN mix compile
RUN mix release


# ================================================
# 2) RUNTIME STAGE
# ================================================
FROM debian:bookworm-slim AS app

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl libssl3 libncurses5 libstdc++6 bash curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG UID=1000
ARG GID=1000

RUN groupadd -g $GID app && useradd -m -u $UID -g app app
USER app

# Copy release from build stage
COPY --from=build /app/_build/prod/rel/tfz ./tfz

ENV MIX_ENV=prod \
    PHX_SERVER=true \
    ERL_EPMD_ADDRESS=127.0.0.1 \
    RELEASE_NODE=tfz

EXPOSE 4000

CMD ["/app/tfz/bin/tfz", "start"]