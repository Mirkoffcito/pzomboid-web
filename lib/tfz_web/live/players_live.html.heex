<div class="p-6">
  <h1 class="text-2xl font-semibold">Online players</h1>

  <div class="mt-2 text-sm opacity-80">
    Status: <%= inspect(@status) %>
    <%= if @last_updated do %>
      · Updated: <%= @last_updated %>
    <% end %>
  </div>

  <div class="mt-4">
    <div class="font-medium">Count: <%= length(@players) %></div>

    <ul class="mt-2 list-disc pl-6">
      <%= for p <- @players do %>
        <li><%= p %></li>
      <% end %>
    </ul>
  </div>
</div>
